# Copy this file to .env and add runtime credentials.
# Provider and model selection belongs in tracked model profiles, not here.
# Never commit modules/context-compiler/.env or real API keys.

# Embedding credential. Endpoint and all non-secret behavior are tracked in the profile.
IGOR_EMBEDDING_API_KEY=

# Completion credential. Endpoint and all non-secret behavior are tracked in the profile.
IGOR_COMPLETION_API_KEY=

# Gemini multimodal completion credential for the document qualification.
GEMINI_API_KEY=
